<div id="lumi-adaptive-preview">
  <style>
    #lumi-adaptive-preview{padding:4px 0;color-scheme:light dark;--lp-bg:light-dark(#ecf3ef,#18242a);--lp-paper:light-dark(#fffefa,#233238);--lp-ink:light-dark(#23363b,#ecf2ed);--lp-muted:light-dark(#5a6e70,#b5c8c7);--lp-line:light-dark(#d9e4dd,#415455);--lp-mint:light-dark(#dfede4,#2a443b);--lp-purple:light-dark(#ede7f7,#3b334b);--lp-peach:light-dark(#ffefdb,#443b2d);--lp-accent:light-dark(#6b54ad,#c5b2f2);--lp-on:light-dark(#ffffff,#261d39);font:400 15px/1.55 'Trebuchet MS','Segoe UI',sans-serif;color:var(--lp-ink)}
    #lumi-adaptive-preview *{box-sizing:border-box}#lumi-adaptive-preview .lp-window{background:var(--lp-bg);padding:23px;border-radius:28px}#lumi-adaptive-preview .lp-top{display:flex;align-items:center;justify-content:space-between;gap:14px;margin-bottom:22px;padding-right:90px;flex-wrap:wrap}#lumi-adaptive-preview .lp-brand{display:flex;align-items:center;gap:11px;font-size:26px}#lumi-adaptive-preview .lp-mark{display:grid;place-items:center;width:42px;height:42px;border-radius:15px;background:var(--lp-peach);color:var(--lp-accent)}#lumi-adaptive-preview .lp-caption{font-size:12px;color:var(--lp-muted)}#lumi-adaptive-preview .lp-layout{display:grid;grid-template-columns:minmax(230px,.8fr) minmax(0,1.6fr);gap:18px}#lumi-adaptive-preview .lp-settings{background:var(--lp-paper);padding:22px;border-radius:23px}#lumi-adaptive-preview .lp-settings h2{font:500 22px/1.3 'Trebuchet MS','Segoe UI',sans-serif;margin:0 0 16px}#lumi-adaptive-preview label{display:block;font-size:13px;margin:12px 0 5px;color:var(--lp-muted)}#lumi-adaptive-preview input,#lumi-adaptive-preview select{font:inherit;font-size:16px;color:var(--lp-ink);background:var(--lp-bg);border:1px solid var(--lp-line);border-radius:12px;padding:10px 11px;width:100%;min-width:0;max-width:100%}#lumi-adaptive-preview .lp-two{display:grid;grid-template-columns:80px minmax(0,1fr);gap:10px}#lumi-adaptive-preview button{font:inherit;font-size:13px;min-height:42px;padding:9px 12px;color:var(--lp-ink);background:var(--lp-paper);border:1px solid var(--lp-line);border-radius:12px}#lumi-adaptive-preview .lp-presets{display:flex;flex-wrap:wrap;gap:6px;margin-bottom:16px}#lumi-adaptive-preview .lp-presets button[aria-pressed=true]{background:var(--lp-accent);color:var(--lp-on);border-color:var(--lp-accent)}#lumi-adaptive-preview .lp-primary{background:var(--lp-accent);color:var(--lp-on);border-color:var(--lp-accent);margin-top:18px;width:100%}#lumi-adaptive-preview .lp-preview{display:grid;gap:14px;align-content:start;min-width:0}#lumi-adaptive-preview .lp-hero{display:flex;align-items:center;gap:8px;background:var(--lp-mint);padding:27px;border-radius:24px;min-height:265px}#lumi-adaptive-preview .lp-copy{flex:1;min-width:0}#lumi-adaptive-preview h1{font:500 31px/1.15 'Trebuchet MS','Segoe UI',sans-serif;letter-spacing:-.6px;margin:13px 0 14px;overflow-wrap:anywhere}#lumi-adaptive-preview .lp-hero p{margin:0;font-size:14px}#lumi-adaptive-preview .lp-hero img{width:190px;height:210px;object-fit:contain;flex:none}#lumi-adaptive-preview .lp-tag{font-size:12px;color:var(--lp-muted);background:var(--lp-paper);border-radius:9px;padding:5px 9px;display:inline-block}#lumi-adaptive-preview .lp-cards{display:grid;grid-template-columns:1fr 1fr;gap:14px}#lumi-adaptive-preview .lp-tile{padding:20px;border-radius:22px;background:var(--lp-paper);min-width:0}#lumi-adaptive-preview .lp-tile:nth-child(2){background:var(--lp-purple)}#lumi-adaptive-preview .lp-tile h3{font:500 19px/1.3 'Trebuchet MS','Segoe UI',sans-serif;margin:11px 0 8px}#lumi-adaptive-preview .lp-tile p{font-size:13px;color:var(--lp-muted);margin:0}#lumi-adaptive-preview .lp-icon{width:36px;height:36px;border-radius:12px;background:var(--lp-mint);display:grid;place-items:center;color:var(--lp-accent)}#lumi-adaptive-preview .lp-footer{font-size:12px;color:var(--lp-muted);padding:0 3px;margin:0}#lumi-adaptive-preview .lp-feedback{color:var(--lp-muted);font-size:12px;min-height:20px;margin-top:10px}#lumi-adaptive-preview [data-style=calm] .lp-hero img{width:120px;height:160px}#lumi-adaptive-preview [data-style=calm] .lp-hero{min-height:230px}#lumi-adaptive-preview [data-preschool=true] .lp-tile h3{font-size:22px}
    @media(max-width:720px){#lumi-adaptive-preview .lp-layout{grid-template-columns:1fr}#lumi-adaptive-preview .lp-settings{padding:18px}#lumi-adaptive-preview .lp-window{padding:15px}#lumi-adaptive-preview .lp-top{padding-right:70px}#lumi-adaptive-preview .lp-hero{padding:22px}#lumi-adaptive-preview h1{font-size:28px}#lumi-adaptive-preview .lp-hero img{width:155px;height:185px}}
    @media(max-width:430px){#lumi-adaptive-preview .lp-window{padding:10px;border-radius:20px}#lumi-adaptive-preview .lp-hero{padding:18px;gap:0}#lumi-adaptive-preview .lp-hero img{width:95px;height:155px;align-self:flex-end}#lumi-adaptive-preview h1{font-size:24px}#lumi-adaptive-preview .lp-cards{grid-template-columns:1fr}#lumi-adaptive-preview .lp-layout{gap:12px}#lumi-adaptive-preview .lp-top{margin:8px 6px 16px}#lumi-adaptive-preview [data-style=calm] .lp-hero img{width:90px;height:125px}}
  </style>
  <section class="lp-window" aria-label="Луми, предпросмотр адаптации профиля">
    <header class="lp-top"><div class="lp-brand"><span class="lp-mark"><i data-lucide="sparkles" aria-hidden="true"></i></span>Луми</div><span class="lp-caption">Настройка профиля · предпросмотр</span></header>
    <div class="lp-layout">
      <section class="lp-settings" aria-label="Параметры профиля">
        <h2>Каждому свой учебный стол</h2>
        <div class="lp-presets" aria-label="Примеры профилей"><button type="button" class="cursor-interaction" data-profile="bogdan" aria-pressed="true">Богдан</button><button type="button" class="cursor-interaction" data-profile="polina" aria-pressed="false">Полина</button><button type="button" class="cursor-interaction" data-profile="alena" aria-pressed="false">Алена</button></div>
        <label for="lp-name">Имя или ник</label><input id="lp-name" maxlength="25" value="Богдан" autocomplete="off">
        <div class="lp-two"><div><label for="lp-age">Возраст</label><input id="lp-age" type="number" min="4" max="19" placeholder="Лет"></div><div><label for="lp-level">Учебный уровень</label><select id="lp-level"><option value="0">Готовимся к школе</option value="1">1 класс</option><option value="2">2 класс</option><option selected value="3">3 класс</option><option value="4">4 класс</option><option value="5">5 класс</option><option value="6">6 класс</option><option value="7">7 класс</option><option value="8">8 класс</option><option value="9">9 класс</option><option value="10">10 класс</option><option value="11">11 класс</option></select></div></div>
        <label for="lp-style">Оформление</label><select id="lp-style"><option value="auto">Подобрать по возрасту и классу</option><option value="friendly">Уютное, с Луми</option><option value="calm">Спокойное</option></select>
        <label for="lp-explanation">Как удобнее объяснять</label><select id="lp-explanation"><option value="steps">По шагам</option><option value="examples">На примерах</option><option value="short">Сначала коротко</option></select>
        <button type="button" class="lp-primary cursor-interaction" id="lp-apply">Посмотреть мой стол</button><div class="lp-feedback" id="lp-feedback" aria-live="polite"></div>
      </section>
      <section class="lp-preview" id="lp-preview" data-style="friendly" data-preschool="false" aria-label="Вид учебного стола">
        <div class="lp-hero"><div class="lp-copy"><span class="lp-tag" id="lp-tag">3 класс</span><h1 id="lp-greeting">Привет, Богдан!<br>Что сегодня узнаем?</h1><p id="lp-description">Разберём непонятное, попробуем сами и проверим черновик перед тетрадью.</p></div><img src="LUMI_PREVIEW_IMAGE" alt="Луми с мятными ушами-листочками, рюкзаком и фонариком-звездой" width="190" height="210"></div>
        <div class="lp-cards"><article class="lp-tile"><span class="lp-icon"><i data-lucide="book-open" aria-hidden="true"></i></span><h3 id="lp-subject">Математика и чтение</h3><p id="lp-topics">Умножение, доли, периметр и понимание текста.</p></article><article class="lp-tile"><span class="lp-icon"><i data-lucide="pencil-line" aria-hidden="true"></i></span><h3 id="lp-practice">Черновик и самопроверка</h3><p id="lp-practice-text">Записать ход решения, проверить вычисления, получить комментарий родителя.</p></article></div>
        <p class="lp-footer" id="lp-footer">Стартовые темы определяет класс. Все уровни можно открыть вручную.</p>
        <p class="lp-footer">Здесь меняется только предпросмотр. Семейные профили и родительский пароль настраиваются в запущенном портале.</p>
      </section>
    </div>
  </section>
  <script>
    (()=>{
      const root=document.getElementById('lumi-adaptive-preview');
      const get=id=>root.querySelector('#'+id);
      const presets={bogdan:{name:'Богдан',age:'',level:3},polina:{name:'Полина',age:'',level:4},alena:{name:'Алена',age:5,level:0}};
      let selected='bogdan';
      function paint(save=false){
        const name=get('lp-name').value.trim()||'исследователь';const age=Number(get('lp-age').value)||null;const level=Number(get('lp-level').value);const choice=get('lp-style').value;const style=choice==='auto'?(age>=13||level>=7?'calm':'friendly'):choice;
        get('lp-preview').dataset.style=style;get('lp-preview').dataset.preschool=String(level===0);
        get('lp-tag').textContent=(level?level+' класс':'Готовимся к школе')+(age?' · '+age+' лет':'');
        get('lp-greeting').textContent='Привет, '+name+'! '+(level>=7?'В чём разберёмся сегодня?':'Что сегодня узнаем?');
        get('lp-description').textContent=level===0?'Поиграем со звуками, числами и историями. Можно заниматься вместе со взрослым.':level>=7?'Выберем нужную тему, проверим рассуждение и потренируемся перед контрольной.':'Разберём непонятное, попробуем сами и проверим черновик перед тетрадью.';
        const topics=level===0?['Первые открытия','Счёт, звуки, формы, слушание и небольшие истории.']:level<=4?['Математика и чтение',level===3?'Умножение, доли, периметр и понимание текста.':level===4?'Вычисления, площадь, русский язык и тренировка навыков ВПР.':'Числа, первые правила языка и понимание текста.']:['Предметы и рассуждение','Математика, языки, естественные науки и проверка источников.'];
        get('lp-subject').textContent=topics[0];get('lp-topics').textContent=topics[1];
        get('lp-practice').textContent=level===0?'Попробуем вместе':level===9?'Тренировка к ОГЭ':level===11?'Тренировка к ЕГЭ':'Черновик и самопроверка';
        get('lp-practice-text').textContent=level===0?'Крупные варианты ответов, чтение задания вслух и помощь взрослого.':level===9||level===11?'Авторские упражнения на отдельные навыки. Официальные материалы - в библиотеке родителя.':'Записать ход решения, проверить вычисления, получить комментарий родителя.';
        const explanation={steps:'по шагам',examples:'на примерах',short:'сначала коротко'}[get('lp-explanation').value];
        get('lp-footer').textContent='Оформление: '+(style==='calm'?'спокойное':'уютное')+'. Объяснения: '+explanation+'. Темы других уровней доступны вручную.';
        root.querySelectorAll('[data-profile]').forEach(b=>b.setAttribute('aria-pressed',String(b.dataset.profile===selected)));
        if(save){get('lp-feedback').textContent='Предпросмотр обновлён.';const host=window.openai;if(host?.setWidgetState)Promise.resolve(host.setWidgetState({modelContent:{app:'Луми',level,style,explanation,demoOnly:true},privateContent:{name,age,level,choice,explanation:get('lp-explanation').value,selected}})).catch(()=>{});}
      }
      root.querySelectorAll('[data-profile]').forEach(b=>b.addEventListener('click',()=>{selected=b.dataset.profile;const p=presets[selected];get('lp-name').value=p.name;get('lp-age').value=p.age;get('lp-level').value=p.level;get('lp-style').value='auto';paint(true);}));
      ['lp-level','lp-style','lp-explanation','lp-age'].forEach(id=>get(id).addEventListener('change',()=>{selected='';paint(true);}));
      get('lp-apply').addEventListener('click',()=>{selected='';paint(true);});
      function restore(value){const s=value?.privateContent;if(!s||!Number.isInteger(s.level)||s.level<0||s.level>11)return;get('lp-name').value=String(s.name||'').slice(0,25);get('lp-age').value=s.age>=4&&s.age<=19?s.age:'';get('lp-level').value=s.level;get('lp-style').value=['auto','friendly','calm'].includes(s.choice)?s.choice:'auto';get('lp-explanation').value=['steps','examples','short'].includes(s.explanation)?s.explanation:'steps';selected=presets[s.selected]?s.selected:'';paint();}
      restore(window.openai?.widgetState);window.addEventListener('openai:set_globals',e=>restore(e.detail?.globals?.widgetState));paint();
    })();
  </script>
</div>
